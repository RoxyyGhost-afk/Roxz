
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#000000">
<title>ROXY | Visual Demo</title>

<style>
*{box-sizing:border-box}
html,body{
  margin:0;width:100%;height:100%;
  overflow:hidden;background:#000;color:#00ff66;
  font-family:monospace;
}
#screen{
  position:fixed;inset:0;background:#000;
  display:grid;place-items:center;
}
video{
  position:absolute;width:100%;height:100%;
  object-fit:contain;background:#000;
}
#matrix{
  position:fixed;inset:0;width:100%;height:100%;
  pointer-events:none;z-index:1;
}
#scanlines{
  position:fixed;inset:0;pointer-events:none;
  opacity:.13;z-index:2;
  background:repeating-linear-gradient(
    to bottom,transparent 0,transparent 3px,
    rgba(255,255,255,.18) 4px
  );
}
#glitch{
  position:fixed;inset:0;pointer-events:none;
  opacity:0;z-index:3;
  background:linear-gradient(
    90deg,transparent 17%,
    rgba(255,0,0,.15) 19%,transparent 22%,
    transparent 72%,rgba(0,255,170,.1) 74%,
    transparent 77%
  );
  animation:glitch 7s infinite steps(1);
}
@keyframes glitch{
  0%,91%,94%,100%{opacity:0;transform:translateX(0)}
  92%{opacity:.75;transform:translateX(3px)}
  93%{opacity:.35;transform:translateX(-4px)}
}
#alert{
  position:relative;z-index:4;
  width:min(88%,400px);padding:24px 18px;
  text-align:center;color:white;
  background:rgba(12,0,0,.94);
  border:2px solid #ff2020;
  box-shadow:0 0 28px #f00;
  animation:flicker 2s infinite;
}
h1{
  margin:8px 0 14px;color:#ff2525;
  font-size:clamp(27px,8vw,38px);
  text-shadow:0 0 12px red;
}
p{font-size:14px;line-height:1.6}
#demo{color:#ff7777;font-size:11px;letter-spacing:1px}
button{
  margin-top:12px;padding:12px 20px;
  border:0;background:#d00;color:#fff;
  font:bold 14px monospace;
}
@keyframes flicker{
  0%,94%,100%{opacity:1}
  95%{opacity:.78}
  97%{opacity:.9}
}
</style>
</head>

<body>
<main id="screen">
  <video id="clip" autoplay muted loop playsinline preload="auto">
    <source src="Hell.mp4" type="video/mp4">
  </video>
</main>

<canvas id="matrix"></canvas>
<div id="scanlines"></div>
<div id="glitch"></div>

<section id="alert">
  <div style="font-size:38px">⚠️</div>
  <h1>VIRUS DETECTED</h1>
  <p>SIMULATED SECURITY ALERT</p>
  <div id="demo">ROXY VISUAL DEMO · NOT A REAL SCAN</div>
  <p>This is a harmless visual effect.<br>
     No virus was detected or installed.</p>
  <button id="closeAlert">CLOSE ALERT</button>
</section>

<script>
const video=document.getElementById('clip');

video.play().catch(()=>{});

document.addEventListener('click',()=>{
  if(video.paused) video.play().catch(()=>{});
},{once:true});

document.getElementById('closeAlert').addEventListener('click',()=>{
  document.getElementById('alert').style.display='none';
});

const canvas=document.getElementById('matrix');
const ctx=canvas.getContext('2d');
const chars='01ROXYアカサタナ';
let drops=[];

function resize(){
  canvas.width=innerWidth;
  canvas.height=innerHeight;
  drops=Array(Math.ceil(canvas.width/16)).fill(1);
}

function draw(){
  ctx.fillStyle='rgba(0,0,0,.09)';
  ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle='#00ff55';
  ctx.font='14px monospace';

  drops.forEach((y,i)=>{
    ctx.fillText(
      chars[Math.floor(Math.random()*chars.length)],
      i*16,y*16
    );
    if(y*16>canvas.height&&Math.random()>.975) drops[i]=0;
    drops[i]++;
  });
}

addEventListener('resize',resize);
resize();
setInterval(draw,65);

// Best-effort Back handling; browser navigation cannot be locked by HTML.
history.pushState({roxy:true},'',location.href);
addEventListener('popstate',()=>{
  history.pushState({roxy:true},'',location.href);
});
</script>
</body>
</html>
